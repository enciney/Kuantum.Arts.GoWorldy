#/-------------------[DOTENV_PUBLIC_KEY]--------------------/
#/            public-key encryption for .env files          /
#/       [how it works](https://dotenvx.com/encryption)     /
#/----------------------------------------------------------/
DOTENV_PUBLIC_KEY="022c0a47343bb72b92d711871d66b3ac8470dfb829b172ef2dec718db378eb9313"

# .env
# API URL — ortama göre değiştir
# iOS Simulator / Expo Web → localhost çalışır (varsayılan)
# EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Android Emülatör → 10.0.2.2 kullan
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api

# Fiziksel cihaz → makinenin yerel IP'sini kullan
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3000/api

# Google Sign-In Client ID'leri (Google Cloud Console → OAuth 2.0)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=858593226942-8p7pl779p8pcenflpnt84iedf8i8aube.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=...apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=...apps.googleusercontent.com

# Web base URL (share butonu için) — prod'da https://goworldy.com olur
EXPO_PUBLIC_WEB_URL=http://localhost:8081
