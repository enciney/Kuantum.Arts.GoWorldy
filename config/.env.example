# ===========================================
# GoWorldy Configuration
# Copy this file as .env.development / .env.production
# ===========================================

# App
NODE_ENV=development
PORT=3000
JWT_SECRET=your-jwt-secret-here

# Database
DB_PROVIDER=sqlite
# For MongoDB:
# DB_PROVIDER=mongodb
# DB_CONNECTION_STRING=mongodb://localhost:27017/goworldy

# Firebase (Auth + Google Login)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=

# Stripe (Payment)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Push Notifications (Expo)
EXPO_ACCESS_TOKEN=

# Admin
ADMIN_EMAIL=admin@goworldy.com
