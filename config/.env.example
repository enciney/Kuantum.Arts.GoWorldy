# ===========================================
# GoWorldy Configuration
# Copy this file as .env.development / .env.production
# ===========================================

# App
NODE_ENV=development
PORT=3000
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRY=7d

APP_NAME=GoWorldy
APP_VERSION=1.0.0
APP_URL=http://localhost:3000

# Database
DB_PROVIDER=sqlite
# For MongoDB:
# DB_PROVIDER=mongodb
# DB_CONNECTION_STRING=mongodb://localhost:27017/goworldy

# Firebase (Auth + Google Login)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=

# Stripe (Payment)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Push Notifications (Expo)
EXPO_ACCESS_TOKEN=

# Admin
ADMIN_EMAIL=admin@goworldy.com
ADMIN_DEFAULT_PASSWORD=admin123

# Roles (Do not change these values)
ROLE_ADMIN=admin
ROLE_MODERATOR=moderator
ROLE_USER=user

# User Types
USER_TYPE_EMIGRANT=emigrant
USER_TYPE_CONSULTANT=consultant
USER_TYPE_DIASPORA=diaspora

# Forum Pricing (in TL)
FORUM_CREATE_TOPIC_COST=50
FORUM_COMMENT_ACCESS_COST=50
FORUM_CREATE_AD_COST=50
FORUM_WEEKLY_TOPIC_REWARD=1

# Premium Pricing (in TL)
PREMIUM_WEEKLY_PRICE=50
PREMIUM_MONTHLY_PRICE=250

# Guide Settings
GUIDE_ENABLE_NOTIFICATIONS=true
GUIDE_ENABLE_RECOMMENDATIONS=true

# Notification Settings
NOTIFICATIONS_ENABLE_EMAIL=true
NOTIFICATIONS_ENABLE_IN_APP=true